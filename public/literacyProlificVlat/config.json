{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/dev/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Literacy study for Prolific (VLAT only)",
    "version": "pilot",
    "authors": ["The reVISit Team"],
    "date": "2023-04-14",
    "description": "A simple demo of using stimuli in an HTML file that renders a D3 visualization. Data is collected via a numeric response field.",
    "organizations": ["University of Utah"]
  },
  "uiConfig": {
    "contactEmail": "contact@revisit.dev",
    "helpTextPath": "demo-html/assets/help.md",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withProgressBar": true,
    "autoDownloadStudy": false,
    "withSidebar": true,
    "windowEventDebounceTime": 200,
    "participantNameField": "introduction.prolificId",
    "studyEndMsg": "Thank you for completing the study. You may click this link and return to Prolific: [https://app.prolific.com/submissions/complete?cc=C1NU6U6J&PROLIFIC_ID={PARTICIPANT_ID}](https://app.prolific.com/submissions/complete?cc=C1NU6U6J&PROLIFIC_ID={PARTICIPANT_ID})",
    "urlParticipantIdParam": "PROLIFIC_PID",
    "recordAudio": false,
    "showTitleBar": false,
    "sidebarWidth": 250
  },
  "importedLibraries": ["mini-vlat", "calvi"],
  "components": {
    "introduction": {
      "type": "markdown",
      "forceTouchScreen": false,
      "recordAudio": false,
      "path": "literacyProlificVlat/assets/introduction.md",
      "response": [
        {
          "id": "prolificId",
          "prompt": "Please enter your Prolific ID",
          "location": "belowStimulus",
          "type": "shortText",
          "placeholder": "Prolific ID",
          "paramCapture": "PROLIFIC_PID"
        }
      ]
    },
    "consent": {
      "type": "markdown",
      "recordAudio": false,
      "path": "literacyProlificVlat/assets/consent.md",
      "nextButtonText": "Agree",
      "response": [
        {
          "id": "accept",
          "prompt": "Do you consent to the study and wish to continue?",
          "requiredValue": "Accept",
          "location": "belowStimulus",
          "type": "radio",
          "options": ["Decline", "Accept"]
        }
      ]
    },
    "vlatIntro": {
      "type": "markdown",
      "recordAudio": false,
      "path": "literacyProlificVlat/assets/vlatIntro.md",
      "response": []
    },
    "demographics": {
      "type": "questionnaire",
      "recordAudio": false,
      "description": "Basic demographic questions including gender, age, and education",
      "response": [
        {
          "id": "gender",
          "prompt": "What is your **gender**?",
          "required": true,
          "location": "aboveStimulus",
          "type": "radio",
          "withOther": true,
          "options": [
            "Woman",
            "Man",
            "Non-binary / Genderqueer / Third gender",
            "Genderfluid / Gender non-conforming",
            "Questioning",
            "Prefer not to say"
          ]
        },
        {
          "id": "age",
          "prompt": "What is your **age**?",
          "required": true,
          "location": "aboveStimulus",
          "type": "radio",
          "options": [
            "Under 18 years",
            "18-24 years",
            "25-34 years",
            "35-44 years",
            "45-54 years",
            "55-64 years",
            "65 years or older",
            "Prefer not to say"
          ]
        },
        {
          "id": "education",
          "prompt": "What is the **highest degree or level of education** you have completed?",
          "required": true,
          "location": "aboveStimulus",
          "type": "radio",
          "withOther": true,
          "options": [
            "Less than high school",
            "High school diploma or equivalent",
            "Bachelor's degree or equivalent",
            "Master's degree or equivalent",
            "Doctoral degree or equivalent"
          ]
        }
      ]
    },
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "introduction",
      "consent",
      "vlatIntro",
      {
        "components": [
          "$mini-vlat.co.treemap",
          "$mini-vlat.co.stackedBar100",
          "$mini-vlat.co.histogram",
          "$mini-vlat.co.choropleth",
          "$mini-vlat.co.piechart",
          "$mini-vlat.co.bubblechart",
          "$mini-vlat.co.stackedbar",
          "$mini-vlat.co.linechart",
          "$mini-vlat.co.barchart",
          "$mini-vlat.co.areachar",
          "$mini-vlat.co.stackedarea",
          "$mini-vlat.co.scatterplot",
          "$calvi.co.T3",
          "$calvi.co.T10",
          "$calvi.co.T14",
          "$calvi.co.T20",
          "$calvi.co.T25",
          "$calvi.co.T26",
          "$calvi.co.T30",
          "$calvi.co.T35",
          "$calvi.co.T37",
          "$calvi.co.T40",
          "$calvi.co.T42",
          "$calvi.co.T43",
          "$calvi.co.T47",
          "$calvi.co.T48",
          "$calvi.co.T49"
        ],
        "order": "random",
        "id": "vlatPart"
      },
      "demographics"
    ]
  }
}
